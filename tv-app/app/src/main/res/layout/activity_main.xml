<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="28dp"
    android:paddingEnd="48dp">

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textSize="28sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/userChip"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:background="@drawable/user_chip"
            android:drawableStart="@drawable/ic_person"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:ellipsize="end"
            android:maxWidth="440dp"
            android:paddingStart="18dp"
            android:paddingEnd="22dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btnRefresh"
            style="@style/IconButton"
            android:drawableStart="@drawable/ic_refresh"
            android:text="@string/refresh" />

        <TextView
            android:id="@+id/btnLogout"
            style="@style/IconButton"
            android:drawableStart="@drawable/ic_logout"
            android:text="@string/logout" />
    </LinearLayout>

    <!-- categories -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/tabAll" style="@style/Chip" android:drawableStart="@drawable/ic_grid" android:text="@string/tab_all" />
        <TextView android:id="@+id/tabVideo" style="@style/Chip" android:drawableStart="@drawable/ic_movie" android:text="@string/tab_video" />
        <TextView android:id="@+id/tabImage" style="@style/Chip" android:drawableStart="@drawable/ic_image" android:text="@string/tab_image" />
        <TextView android:id="@+id/tabAudio" style="@style/Chip" android:drawableStart="@drawable/ic_audio" android:text="@string/tab_audio" />
        <TextView android:id="@+id/tabFile" style="@style/Chip" android:drawableStart="@drawable/ic_file" android:text="@string/tab_file" />
    </LinearLayout>

    <TextView
        android:id="@+id/warn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/warn_bar"
        android:padding="12dp"
        android:text="@string/blocked"
        android:textColor="@color/warn"
        android:textSize="16sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="10dp"
            android:paddingBottom="28dp" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:src="@drawable/ic_inbox" />

            <TextView
                android:id="@+id/emptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/empty_title"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/emptyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="560dp"
                android:textColor="@color/text_dim"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
