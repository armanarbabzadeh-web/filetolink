<?xml version="1.0" encoding="utf-8"?>
<!-- Phone layout of the file list (TVs use activity_main.xml). Same ids, touch-sized. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRefresh"
            style="@style/PhoneIcon"
            android:contentDescription="@string/refresh"
            android:drawableStart="@drawable/ic_refresh" />

        <TextView
            android:id="@+id/btnLogout"
            style="@style/PhoneIcon"
            android:contentDescription="@string/logout"
            android:drawableStart="@drawable/ic_logout" />
    </LinearLayout>

    <!-- account + used space -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/user_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.teletvshare.tv.UsageRing
            android:id="@+id/usageRing"
            android:layout_width="44dp"
            android:layout_height="44dp" />

        <TextView
            android:id="@+id/userChip"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- categories + sort: scroll sideways so every option is reachable on a narrow screen -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/tabAll" style="@style/PhoneChip" android:drawableStart="@drawable/ic_grid" android:text="@string/tab_all" />
            <TextView android:id="@+id/tabVideo" style="@style/PhoneChip" android:drawableStart="@drawable/ic_movie" android:text="@string/tab_video" />
            <TextView android:id="@+id/tabImage" style="@style/PhoneChip" android:drawableStart="@drawable/ic_image" android:text="@string/tab_image" />
            <TextView android:id="@+id/tabAudio" style="@style/PhoneChip" android:drawableStart="@drawable/ic_audio" android:text="@string/tab_audio" />
            <TextView android:id="@+id/tabFile" style="@style/PhoneChip" android:drawableStart="@drawable/ic_file" android:text="@string/tab_file" />
            <TextView android:id="@+id/btnSort" style="@style/PhoneChip" android:drawableStart="@drawable/ic_sort" android:text="@string/sort_newest" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/warn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/warn_bar"
        android:padding="10dp"
        android:text="@string/blocked"
        android:textColor="@color/warn"
        android:textSize="14sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_inbox" />

            <TextView
                android:id="@+id/emptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/empty_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/emptyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/text_dim"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
