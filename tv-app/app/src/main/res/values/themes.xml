<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:textColor">@color/text</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">26dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="AppDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="colorAccent">@color/accent</item>
        <item name="buttonBarButtonStyle">@style/DialogButton</item>
    </style>
    <style name="DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:background">@drawable/dialog_btn</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
    <!-- phone sizes (touch targets 44dp, smaller text) -->
    <style name="PhoneChip" parent="Chip">
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="PhoneIcon" parent="Chip">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

    <style name="IconButton" parent="Chip">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>
</resources>
