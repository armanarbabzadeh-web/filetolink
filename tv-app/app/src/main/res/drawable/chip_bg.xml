<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><gradient android:angle="0" android:startColor="@color/blue" android:endColor="@color/accent" /><corners android:radius="30dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="@color/surface_focus" /><stroke android:width="2dp" android:color="@color/accent" /><corners android:radius="30dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#33FFFFFF" /><corners android:radius="30dp" /></shape>
    </item>
</selector>
